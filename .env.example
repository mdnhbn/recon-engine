# লোকালি .env নামে কপি করে ভ্যালু বসাও (অথবা Render-এর Environment ট্যাবে বসাও)

SECRET_KEY=change-this-to-something-random
DATABASE_URL=sqlite:///recon.db
# Render-এ Postgres অ্যাড করলে এরকম দেখতে হবে:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DEFAULT_DAILY_SCAN_LIMIT=10
PORT=5000

